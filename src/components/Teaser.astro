---
/**
 * YouTube teaser behind a click: nothing is loaded from YouTube until the
 * visitor asks for it (privacy friendly), and the player then comes from
 * youtube-nocookie.com. The preview uses one of our own pictures.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';

interface Props {
    url: string;
    cover?: ImageMetadata;
    title: string;
}

const { url, cover, title } = Astro.props;
const id = url.match(/(?:v=|youtu\.be\/|embed\/|shorts\/)([\w-]{11})/)?.[1];
---
{id ? (
    <figure class="video" data-video={id} data-title={`Teaser — ${title}`}>
        <button type="button" class="video-cover" data-video-play aria-label={`Lire le teaser de ${title}`}>
            {cover && (
                <Picture src={cover} widths={[640, 960, 1280]} sizes="(min-width: 62rem) 760px, 100vw" formats={['avif', 'webp']} alt="" loading="lazy" />
            )}
            <span class="video-play"><Icon name="play" /></span>
            <span class="video-label">Voir le teaser</span>
        </button>
        <figcaption>
            La vidéo est hébergée par YouTube, qui sera contacté au lancement.{' '}
            <a href={url} target="_blank" rel="noopener">Ouvrir sur YouTube</a>
        </figcaption>
    </figure>
) : (
    <a href={url} class="button is-primary" target="_blank" rel="noopener"><Icon name="play-circle" />Voir le teaser</a>
)}

<script>
    document.querySelectorAll<HTMLElement>('[data-video]').forEach((video) => {
        video.querySelector('[data-video-play]')?.addEventListener('click', () => {
            const iframe = document.createElement('iframe');
            iframe.src = `https://www.youtube-nocookie.com/embed/${video.dataset.video}?autoplay=1&rel=0`;
            iframe.title = video.dataset.title ?? 'Vidéo YouTube';
            iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
            iframe.allowFullscreen = true;
            video.querySelector('[data-video-play]')!.replaceWith(iframe);
        });
    });
</script>
