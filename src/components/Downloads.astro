---
import { statSync } from 'node:fs';
import Icon from './Icon.astro';

interface Props {
    files: { label: string; file: string }[];
}

const { files } = Astro.props;

/** "PDF · 1,4 Mo" */
const describe = (file: string) => {
    const type = file.split('.').pop()?.toUpperCase() ?? '';
    try {
        const size = statSync(`public${decodeURI(file)}`).size;
        const mo = size / 1024 / 1024;
        const label = mo >= 1 ? `${mo.toFixed(1).replace('.', ',')} Mo` : `${Math.max(1, Math.round(size / 1024))} Ko`;
        return `${type} · ${label}`;
    } catch {
        return type;
    }
};
---
<ul class="downloads">
    {files.map(({ label, file }) => (
        <li>
            <a href={file} download>
                <Icon name={file.endsWith('.zip') ? 'file-zip' : file.match(/\.(jpe?g|png|webp)$/i) ? 'file-image' : 'file-pdf'} />
                <span>{label}<small>{describe(file)}</small></span>
                <Icon name="download-simple" class="download" />
            </a>
        </li>
    ))}
</ul>
